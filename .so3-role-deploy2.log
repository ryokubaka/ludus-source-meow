    "cmd": "set -euo pipefail\nLOG=\"/var/log/ludus-so-setup.log\"\nPIDFILE=\"/var/run/ludus-so-setup.pid\"\n# so-setup writes nmcli errors into /root/sosetup.log (often not ansible stdout).\nSOLOG=/root/sosetup.log\n# Terminal failures only. Do NOT match bare \"giving up.\" — so-elasticsearch-wait\n# writes that during retries and leaves it in sosetup.log even after heal/highstate.\nFAIL_RE='unrecoverable failure|unknown connection|Command continues to fail|Setup encountered an unrecoverable'\nfailed=0\nif grep -qiE \"$FAIL_RE\" \"$LOG\" 2>/dev/null || grep -qiE \"$FAIL_RE\" \"$SOLOG\" 2>/dev/null; then\n  failed=1\nfi\nif [[ ! -f \"$PIDFILE\" ]]; then\n  echo \"missing-pidfile\"\n  exit 1\nfi\npid=$(cat \"$PIDFILE\")\nif kill -0 \"$pid\" 2>/dev/null; then\n  if [[ \"$failed\" -eq 1 ]]; then\n    echo \"failed-log-running\"\n    echo \"--- $LOG ---\"\n    tail -40 \"$LOG\" 2>/dev/null || true\n    echo \"--- $SOLOG ---\"\n    tail -40 \"$SOLOG\" 2>/dev/null || true\n    kill \"$pid\" 2>/dev/null || true\n    exit 1\n  fi\n  echo \"running pid=${pid}\"\n  if [[ -f \"$SOLOG\" ]]; then\n    tail -3 \"$SOLOG\" 2>/dev/null || true\n  else\n    tail -5 \"$LOG\" 2>/dev/null || true\n  fi\n  exit 2\nfi\n# Prefer live health over stale log FAIL_RE after so-setup exits.\nif command -v so-status >/dev/null 2>&1 && so-status >/dev/null 2>&1; then\n  echo \"complete-so-status\"\n  exit 0\nfi\nif grep -qiE 'setup complete|installation complete|Setup completed|SO setup complete' \"$LOG\" \"$SOLOG\" 2>/dev/null; then\n  echo \"complete-log\"\n  exit 0\nfi\nif [[ \"$failed\" -eq 1 ]]; then\n  echo \"failed-log\"\n  echo \"--- $LOG ---\"\n  tail -40 \"$LOG\" 2>/dev/null || true\n  echo \"--- $SOLOG ---\"\n  tail -40 \"$SOLOG\" 2>/dev/null || true\n  exit 1\nfi\necho \"exited-unknown\"\necho \"--- $LOG ---\"\ntail -40 \"$LOG\" 2>/dev/null || true\necho \"--- $SOLOG ---\"\ntail -40 \"$SOLOG\" 2>/dev/null || true\nexit 1\n",
