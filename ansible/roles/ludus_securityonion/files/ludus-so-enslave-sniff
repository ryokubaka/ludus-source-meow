#!/bin/bash
# Ensure bond0 exists and the sniff NIC is enslaved (SO sensors use bond0).
# SNIFF and MTU come from /etc/ludus-so-enslave-sniff.conf or the environment.
set -euo pipefail

CONF="${LUDUS_SO_ENSLAVE_CONF:-/etc/ludus-so-enslave-sniff.conf}"
if [[ -f "$CONF" ]]; then
  # shellcheck disable=SC1090
  source "$CONF"
fi

SNIFF="${SNIFF:-}"
BOND="${BOND:-bond0}"
MTU="${MTU:-1500}"
SYS="${LUDUS_SO_SYSFS:-/sys/class/net}"

[[ -n "$SNIFF" ]] || { echo "sniff-unset"; exit 1; }
[[ -d "$SYS/$SNIFF" ]] || { echo "sniff-missing=$SNIFF"; exit 1; }

nm_was_active=0

nm_active() {
  [[ "${LUDUS_SO_SKIP_NM:-}" == "1" ]] && return 1
  systemctl is-active --quiet NetworkManager 2>/dev/null
}

# nmcli exits 8 when NetworkManager is not running. SO boots that way, and
# set -e would abort before the bond MTU is lowered.
nm() {
  nm_active || return 0
  command -v nmcli >/dev/null 2>&1 || return 0
  nmcli "$@" >/dev/null 2>&1 || true
}

restore_nm() {
  [[ "$nm_was_active" == "1" ]] || return 0
  systemctl start NetworkManager >/dev/null 2>&1 || true
}
trap restore_nm EXIT

stop_nm() {
  nm_active || return 0
  nm_was_active=1
  systemctl stop NetworkManager >/dev/null 2>&1 || true
}

# so-setup leaves bond0 at 9000. A virtio sniff NIC cannot exceed the range
# bridge (usually 1500); the kernel refuses the enslave with EINVAL. Clamp to
# the NIC MTU and lower the bond before adding the slave.
target_mtu() {
  local nic_mtu="${MTU}"
  if [[ -f "$SYS/$SNIFF/mtu" ]]; then
    nic_mtu=$(cat "$SYS/$SNIFF/mtu")
  fi
  if [[ "$MTU" -lt "$nic_mtu" ]]; then
    echo "$MTU"
  else
    echo "$nic_mtu"
  fi
}

lower_bond_mtu() {
  local target
  target=$(target_mtu)
  ip link set "$BOND" down 2>/dev/null || true
  ip link set "$BOND" mtu "$target"
  ip link set "$SNIFF" mtu "$target" 2>/dev/null || true
}

add_slave() {
  local bond_mtu slave_mtu
  bond_mtu=$(cat "$SYS/$BOND/mtu" 2>/dev/null || echo 0)
  slave_mtu=$(cat "$SYS/$SNIFF/mtu" 2>/dev/null || echo "$MTU")
  if [[ "$bond_mtu" -gt "$slave_mtu" ]]; then
    echo "refusing to enslave $SNIFF: bond mtu $bond_mtu > nic mtu $slave_mtu" >&2
    return 1
  fi
  echo "+$SNIFF" > "$SYS/$BOND/bonding/slaves"
}

create_bond() {
  local target
  target=$(target_mtu)
  if nm_active && command -v nmcli >/dev/null 2>&1; then
    while IFS= read -r con; do
      [[ -z "$con" ]] && continue
      nm con down "$con"
      nm con delete "$con"
    done < <(nmcli -t -f NAME con show 2>/dev/null | grep -E '^(bond0|bond0-slave-)' || true)
    nm device disconnect "$SNIFF"
    nm con add type bond con-name bond0 ifname bond0 mode balance-rr \
      ipv4.method disabled ipv6.method ignore connection.autoconnect yes \
      802-3-ethernet.mtu "$target"
    nm con add type ethernet con-name "bond0-slave-${SNIFF}" ifname "$SNIFF" master bond0 \
      connection.autoconnect yes ipv4.method disabled ipv6.method ignore \
      802-3-ethernet.mtu "$target"
    nm con up bond0
    nm con up "bond0-slave-${SNIFF}"
  fi
  if [[ ! -d "$SYS/$BOND" ]]; then
    modprobe bonding 2>/dev/null || true
    [[ -f "$SYS/bonding_masters" ]] && echo "+${BOND}" > "$SYS/bonding_masters" 2>/dev/null || true
    ip link add name "$BOND" type bond mode balance-rr miimon 100 2>/dev/null \
      || ip link add name "$BOND" type bond mode 0 miimon 100 2>/dev/null \
      || true
    ip link set "$SNIFF" down 2>/dev/null || true
    ip link set "$SNIFF" nomaster 2>/dev/null || true
    lower_bond_mtu || true
    ip link set "$SNIFF" master "$BOND" 2>/dev/null || true
    ip link set "$SNIFF" up 2>/dev/null || true
    ip link set "$BOND" up 2>/dev/null || true
  fi
}

if [[ ! -d "$SYS/$BOND" ]]; then
  create_bond
  if [[ ! -d "$SYS/$BOND" ]]; then
    echo "bond-create-failed"
    exit 1
  fi
  echo "created-bond0"
fi

slaves=$(cat "$SYS/$BOND/bonding/slaves" 2>/dev/null || true)
if [[ " $slaves " == *" $SNIFF "* ]]; then
  lower_bond_mtu || true
  ip link set "$SNIFF" up 2>/dev/null || true
  ip link set "$BOND" up 2>/dev/null || true
  echo "bond-ok=$SNIFF"
  exit 0
fi

stop_nm
ip link set "$SNIFF" down 2>/dev/null || true
ip link set "$BOND" down 2>/dev/null || true
for s in $slaves; do
  echo "-$s" > "$SYS/$BOND/bonding/slaves" 2>/dev/null || true
done
lower_bond_mtu
add_slave
ip link set "$SNIFF" up
ip link set "$BOND" up
echo "enslaved $SNIFF -> $BOND"
